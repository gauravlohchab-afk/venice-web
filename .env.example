# Where form submissions are POSTed as JSON (Formspree, Web3Forms, Basin, your own API...).
# Leave empty to fall back to opening the visitor's email app addressed to the clinic.
VITE_FORM_ENDPOINT=
# Set to true after `npm run fetch-media` to serve self-hosted AVIF/WebP images.
VITE_LOCAL_MEDIA=false

# Lead API used by the booking and consultation forms (defaults are built in).
VITE_LEADS_URL=https://miraculous-serenity-production-5d5a.up.railway.app/api/leads
VITE_LEADS_CENTER=venice-wellness-institute
